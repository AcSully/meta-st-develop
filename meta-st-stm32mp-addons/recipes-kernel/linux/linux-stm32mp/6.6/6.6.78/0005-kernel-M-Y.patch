From 29cf3234de4b67ec8a5cfae986064a03e467776d Mon Sep 17 00:00:00 2001
From: niuke <sully.niu@outlook.com>
Date: Tue, 6 Jan 2026 15:50:21 +0800
Subject: [PATCH 05/13] kernel M -> Y

---
 arch/arm64/configs/stm32mp257_defconfig | 19 ++++++++++---------
 1 file changed, 10 insertions(+), 9 deletions(-)

diff --git a/arch/arm64/configs/stm32mp257_defconfig b/arch/arm64/configs/stm32mp257_defconfig
index 92b22e650..a8d797f75 100644
--- a/arch/arm64/configs/stm32mp257_defconfig
+++ b/arch/arm64/configs/stm32mp257_defconfig
@@ -1089,7 +1089,7 @@ CONFIG_DEFAULT_CUBIC=y
 # CONFIG_DEFAULT_RENO is not set
 CONFIG_DEFAULT_TCP_CONG="cubic"
 CONFIG_TCP_MD5SIG=y
-CONFIG_IPV6=m
+CONFIG_IPV6=y
 # CONFIG_IPV6_ROUTER_PREF is not set
 # CONFIG_IPV6_OPTIMISTIC_DAD is not set
 # CONFIG_INET6_AH is not set
@@ -1113,6 +1113,7 @@ CONFIG_IPV6_MROUTE_MULTIPLE_TABLES=y
 CONFIG_IPV6_PIMSM_V2=y
 CONFIG_IPV6_SEG6_LWTUNNEL=y
 CONFIG_IPV6_SEG6_HMAC=y
+CONFIG_IPV6_SEG6_BPF=y
 # CONFIG_IPV6_RPL_LWTUNNEL is not set
 # CONFIG_IPV6_IOAM6_LWTUNNEL is not set
 # CONFIG_NETLABEL is not set
@@ -1885,8 +1886,8 @@ CONFIG_PCI_HISI=y
 CONFIG_PCIE_KIRIN=y
 # CONFIG_PCIE_DW_PLAT_HOST is not set
 # CONFIG_PCIE_DW_PLAT_EP is not set
-CONFIG_PCIE_STM32=m
-CONFIG_PCIE_STM32_EP=m
+CONFIG_PCIE_STM32=y
+CONFIG_PCIE_STM32_EP=y
 # end of DesignWare-based PCIe controllers
 
 #
@@ -4180,8 +4181,8 @@ CONFIG_THERMAL_EMULATION=y
 #
 # STMicroelectronics thermal drivers
 #
-# CONFIG_ST_THERMAL is not set
-# CONFIG_ST_THERMAL_MEMMAP is not set
+CONFIG_ST_THERMAL=y
+CONFIG_ST_THERMAL_MEMMAP=y
 # end of STMicroelectronics thermal drivers
 
 CONFIG_GENERIC_ADC_THERMAL=m
@@ -5263,8 +5264,8 @@ CONFIG_DUMMY_CONSOLE_ROWS=25
 # end of Console display driver support
 
 CONFIG_LOGO=y
-# CONFIG_LOGO_LINUX_MONO is not set
-# CONFIG_LOGO_LINUX_VGA16 is not set
+CONFIG_LOGO_LINUX_MONO=y
+CONFIG_LOGO_LINUX_VGA16=y
 CONFIG_LOGO_LINUX_CLUT224=y
 # end of Graphics support
 
@@ -7048,8 +7049,8 @@ CONFIG_QCOM_SPMI_VADC=m
 CONFIG_QCOM_SPMI_ADC5=m
 # CONFIG_RICHTEK_RTQ6056 is not set
 CONFIG_SD_ADC_MODULATOR=m
-CONFIG_STM32_ADC_CORE=m
-CONFIG_STM32_ADC=m
+CONFIG_STM32_ADC_CORE=y
+CONFIG_STM32_ADC=y
 # CONFIG_STM32_DFSDM_CORE is not set
 # CONFIG_STM32_DFSDM_ADC is not set
 CONFIG_STM32_MDF_CORE=y
