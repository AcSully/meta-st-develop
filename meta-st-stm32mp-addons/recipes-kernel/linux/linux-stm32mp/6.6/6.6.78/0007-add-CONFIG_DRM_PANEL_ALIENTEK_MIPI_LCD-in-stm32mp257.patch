--- a/arch/arm64/configs/stm32mp257_defconfig
+++ b/arch/arm64/configs/stm32mp257_defconfig
@@ -4999,6 +4999,7 @@ CONFIG_DRM_PANEL=y
 #
 # Display Panels
 #
+CONFIG_DRM_PANEL_ALIENTEK_MIPI_LCD=y
 # CONFIG_DRM_PANEL_ABT_Y030XX067A is not set
 # CONFIG_DRM_PANEL_ARM_VERSATILE is not set
 # CONFIG_DRM_PANEL_ASUS_Z00T_TM5P5_NT35596 is not set
