+static void pcm_pop_work_events(struct work_struct *work)
+{
+    struct es8388_priv *es8388 =
+        container_of(work, struct es8388_priv, pcm_pop_work.work);
+    /* open dac output here */
+    regmap_write(es8388->regmap, 0x04, 0x3c);
+}
