+static int es8388_i2c_probe(struct i2c_client *i2c)
+{
+    struct es8388_priv *es8388;
+    int ret = -1;
+    int hp_irq = 0;
+
+    es8388 = devm_kzalloc(&i2c->dev, sizeof(struct es8388_priv), GFP_KERNEL);
+    if (!es8388)
+        return -ENOMEM;
+
+    i2c_set_clientdata(i2c, es8388);
+    es8388->i2c = i2c;
+
+    es8388->spk_ctl_gpio = devm_gpiod_get_optional(&i2c->dev,"spk-con",GPIOD_OUT_HIGH);
+	if (IS_ERR(es8388->spk_ctl_gpio)) {
+        dev_err(&i2c->dev, "Failed to get spk-con-gpio descriptor\n");
+    	return PTR_ERR(es8388->spk_ctl_gpio);
+    }
+    
+    es8388->hp_det_gpio = devm_gpiod_get_optional(&i2c->dev, "hp-det", GPIOD_IN);
+    if (IS_ERR(es8388->hp_det_gpio)) {
+        dev_err(&i2c->dev, "Failed to get hp-det-gpio descriptor\n");
+		return PTR_ERR(es8388->hp_det_gpio);
+    }
+
+    hp_irq = gpiod_to_irq(es8388->hp_det_gpio);
+
+    if (hp_irq > 0) {
+		ret = devm_request_threaded_irq(&i2c->dev, hp_irq, NULL,
+						hp_det_irq_handler, IRQ_TYPE_EDGE_BOTH  | IRQF_ONESHOT ,"ES8388", es8388);
+		if (ret < 0) {
+			dev_err(&i2c->dev, "request_irq failed: %d\n", ret);
+			return ret;
+		}
+	}
+
+    /* Enable the following code if there is no mclk.
+     * a clock named "mclk" need to be defined in the dts (see sample dts)
+     *
+     * No need to enable the following code to get mclk if:
+     * 1. sclk/bclk is used as mclk
+     * 2. mclk is controled by soc I2S
+     */
+#if 1
+    es8388->mclk = devm_clk_get(&i2c->dev, "MCLK");
+    if (IS_ERR(es8388->mclk)) {
+        dev_err(&i2c->dev, "%s mclk is missing or invalid\n", __func__);
+        return PTR_ERR(es8388->mclk);
+    }
+
+    ret = clk_prepare_enable(es8388->mclk);
+    if (ret)
+        return ret;
+#endif
+
+	for (int i = 0; i < ARRAY_SIZE(es8388->supplies); i++)
+		es8388->supplies[i].supply = es8388_supply_names[i];
+
+	ret = devm_regulator_bulk_get(&i2c->dev, ARRAY_SIZE(es8388->supplies),
+				      es8388->supplies);
+	if (ret != 0) {
+		dev_err(&i2c->dev, "Failed to request supplies: %d\n", ret);
+		return ret;
+	}
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(es8388->supplies),
+				    es8388->supplies);
+	if (ret != 0) {
+		dev_err(&i2c->dev, "Failed to enable supplies: %d\n", ret);
+		return ret;
+	}
+
+    es8388->regmap = devm_regmap_init_i2c(i2c, &es8388_regmap_config);
+    INIT_DELAYED_WORK(&es8388->pcm_pop_work,
+                pcm_pop_work_events);
+    ret = snd_soc_register_codec(&i2c->dev,
+                     &soc_codec_dev_es8388,
+                     &es8388_dai, 1);
+
+    es8388_private = es8388;
+
+    return ret;
+}
+
+static void es8388_i2c_remove(struct i2c_client *client)
+{
+    snd_soc_unregister_codec(&client->dev);
+}
+
+static const struct i2c_device_id es8388_i2c_id[] = {
+    {"es8388", 0},
+    {}
+};
+
+MODULE_DEVICE_TABLE(i2c, es8388_i2c_id);
+
+void es8388_i2c_shutdown(struct i2c_client *client)
+{
+    // struct es8388_priv *es8388 = es8388_private;
+
+    mdelay(20);
+    snd_soc_write(es8388_codec, ES8388_CONTROL2, 0x58);
+    snd_soc_write(es8388_codec, ES8388_CONTROL1, 0x32);
+    snd_soc_write(es8388_codec, ES8388_CHIPPOWER, 0xf3);
+    snd_soc_write(es8388_codec, ES8388_DACPOWER, 0xc0);
+    mdelay(50);
+    snd_soc_write(es8388_codec, ES8388_DACCONTROL26, 0x00);
+    snd_soc_write(es8388_codec, ES8388_DACCONTROL27, 0x00);
+    mdelay(50);
+    snd_soc_write(es8388_codec, ES8388_CONTROL1, 0x30);
+    snd_soc_write(es8388_codec, ES8388_CONTROL1, 0x34);
+}
+
+static const struct of_device_id es8388_of_match[] = {
+    { .compatible = "everest,es8388", },
+    { .compatible = "alientek,es8388", },
+    { }
+};
+MODULE_DEVICE_TABLE(of, es8388_of_match);
+
+static struct i2c_driver es8388_i2c_driver = {
+    .driver = {
+        .name = "ES8388",
+        .of_match_table = of_match_ptr(es8388_of_match),
+        },
+    .shutdown = es8388_i2c_shutdown,
+    .probe = es8388_i2c_probe,
+    .remove = es8388_i2c_remove,
+    .id_table = es8388_i2c_id,
+};
+module_i2c_driver(es8388_i2c_driver);
+
